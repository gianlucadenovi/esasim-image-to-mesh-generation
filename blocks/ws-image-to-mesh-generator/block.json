{
    "id": "ws-image-to-mesh-generator",
    "version": "1",
    "name": "Image to mesh generator",
    "category": "AI",
    "icon": "cpu",
    "side": "backend",
    "customizable": true,
    "summary": "Photos to 3D meshes on an NVIDIA GPU: TripoSR (coloured), Hunyuan3D-2 mini (detailed shape) or Hunyuan3D-2 multi-view (front/left/back/right fused); GLB/OBJ/STL/PLY, shaded previews.",
    "help": "Start it from the Mesh Studio view. Generate meshes sends the pictures in the run's own settings (compact, up to 1024 px) or live as messages. Or, for a run from the blueprint, give Image links (one per line) or wire pictures to Images and turn on Run without the View. Models: TripoSR (MIT, coloured mesh, seconds), Hunyuan3D-2 mini (detailed shape without colour, about 6 GB of GPU memory), Hunyuan3D-2 multi-view (pictures of one object from the front, left, back and right fused into one shape). Hunyuan3D-2 is under the Tencent Hunyuan Community licence, which does not cover the EU, the UK or South Korea.",
    "inputs": [
        {
            "id": "images",
            "label": "Images (optional)",
            "type": "files",
            "many": true,
            "optional": true,
            "formats": [
                "png",
                "jpg",
                "jpeg",
                "webp"
            ],
            "help": "Pictures for a run started from the blueprint (with Run without the View on)"
        }
    ],
    "outputs": [
        {
            "id": "glb",
            "label": "Meshes (GLB)",
            "type": "files",
            "formats": [
                "glb"
            ],
            "help": "One GLB per object: for the 3D view and downloads"
        },
        {
            "id": "exports",
            "label": "Other formats",
            "type": "files",
            "formats": [
                "obj",
                "stl",
                "ply"
            ]
        },
        {
            "id": "previews",
            "label": "Previews",
            "type": "files",
            "formats": [
                "png"
            ]
        },
        {
            "id": "table",
            "label": "Mesh inventory",
            "type": "table",
            "formats": [
                "csv"
            ]
        },
        {
            "id": "metadata",
            "label": "Run metadata",
            "type": "files",
            "formats": [
                "json"
            ]
        }
    ],
    "params": [
        {
            "key": "model",
            "label": "Model",
            "type": "select",
            "default": "Hunyuan3D-2 mini",
            "options": [
                "TripoSR",
                "Hunyuan3D-2 mini",
                "Hunyuan3D-2 multi-view"
            ]
        },
        {
            "key": "quality",
            "label": "Quality",
            "type": "select",
            "default": "balanced",
            "options": [
                "fast",
                "balanced",
                "high"
            ],
            "help": "TripoSR: surface resolution 192 / 256 / 320. Hunyuan3D-2: turbo 5 steps / 30 steps / 50 steps at a finer octree"
        },
        {
            "key": "candidates",
            "label": "Variations per object (Hunyuan3D-2)",
            "type": "number",
            "default": 1,
            "min": 1,
            "max": 4
        },
        {
            "key": "seed",
            "label": "Seed",
            "type": "number",
            "default": 1234,
            "min": 0,
            "max": 2147483647
        },
        {
            "key": "formats",
            "label": "Mesh formats",
            "type": "text",
            "default": "glb,obj,stl,ply"
        },
        {
            "key": "image_urls",
            "label": "Image links",
            "type": "textarea",
            "default": "",
            "help": "One picture link per line, for a run from the blueprint"
        },
        {
            "key": "run_without_view",
            "label": "Run without the View",
            "type": "bool",
            "default": false,
            "help": "On: a blueprint Run generates from Image links / the Images input. Off: only the View starts generation"
        },
        {
            "key": "launch",
            "label": "Requested by Mesh Studio (View only)",
            "type": "bool",
            "default": false
        },
        {
            "key": "session",
            "label": "Upload session (View only)",
            "type": "text",
            "default": ""
        },
        {
            "key": "upload_manifest",
