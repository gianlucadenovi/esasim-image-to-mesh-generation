{
    "id": "ws-image-to-mesh-studio",
    "version": "1",
    "name": "Image to Mesh Studio",
    "category": "Visualizers",
    "icon": "image",
    "side": "frontend",
    "customizable": true,
    "summary": "View-first image uploads, model selection, batch generation, progress, mesh preview thumbnails, statistics and export downloads.",
    "help": "Compact compressed image uploads via chunked per-run settings, with integrity checksum. Saves selected images and result cards in View state so they reappear across runs. Current View API lacks native file upload and old-run file handles; previous download URLs can expire.",
    "inputs": [
        {
            "id": "meshes",
            "label": "Mesh results",
            "type": "files",
            "many": true,
            "optional": true,
            "formats": [
                "glb",
                "obj",
                "stl",
                "ply"
            ]
        },
        {
            "id": "previews",
            "label": "Mesh snapshots",
            "type": "files",
            "many": true,
            "optional": true,
            "formats": [
                "png"
            ]
        },
        {
            "id": "details",
            "label": "Mesh metadata",
            "type": "table",
            "optional": true,
            "formats": [
                "csv"
            ]
        },
        {
            "id": "status",
            "label": "Live progress",
            "type": "telemetry",
            "optional": true
        }
    ],
    "outputs": [],
    "params": [],
    "view": {
        "w": 6,
        "h": 7,
        "resize": "both"
    },
    "permissions": [
        "run"
    ],
    "esasim": {
        "version": 2
    }
}
