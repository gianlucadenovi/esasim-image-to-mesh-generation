{
    "id": "ws-image-to-mesh-studio",
    "version": "1",
    "name": "Image to Mesh Studio",
    "category": "Visualizers",
    "icon": "chart",
    "side": "frontend",
    "customizable": true,
    "summary": "Choose photos and a model, press Generate meshes: several photos of one object become one mesh (multi-view); shaded previews and GLB/OBJ/STL/PLY downloads.",
    "help": "Press Run once to open the studio, then drop pictures and press Generate meshes. Several pictures of one object switch to Hunyuan3D-2 multi-view, which fuses up to four of them (front, left, back, right) into one mesh: check each picture's side; extra pictures are marked \"not used\". To make a separate mesh from every picture, choose Hunyuan3D-2 mini or TripoSR instead.",
    "inputs": [
        {
            "id": "glb",
            "label": "Meshes (GLB)",
            "type": "files",
            "many": true,
            "optional": true,
            "formats": [
                "glb"
            ]
        },
        {
            "id": "exports",
            "label": "Other formats",
            "type": "files",
            "many": true,
            "optional": true,
            "formats": [
                "obj",
                "stl",
                "ply"
            ]
        },
        {
            "id": "previews",
            "label": "Previews",
            "type": "files",
            "many": true,
            "optional": true,
            "formats": [
                "png"
            ]
        },
        {
            "id": "details",
            "label": "Mesh inventory",
            "type": "table",
            "optional": true,
            "formats": [
                "csv"
            ]
        },
        {
            "id": "status",
            "label": "Live progress",
            "type": "telemetry",
            "optional": true
        }
    ],
    "outputs": [],
    "params": [],
    "view": {
        "w": 6,
        "h": 7,
        "resize": "both"
    },
    "permissions": [
        "run"
    ],
    "esasim": {
        "version": 12
    }
}
