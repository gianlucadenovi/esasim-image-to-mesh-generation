{
    "id": "ws-image-to-mesh-studio",
    "version": "1",
    "name": "Image to Mesh Studio",
    "category": "Visualizers",
    "icon": "chart",
    "side": "frontend",
    "customizable": true,
    "summary": "Choose photos and a model, press Generate meshes: pictures travel in the run's own settings; shaded previews and GLB/OBJ/STL/PLY downloads.",
    "help": "Drop pictures, choose TripoSR, Hunyuan3D-2 mini or Hunyuan3D-2 multi-view and a quality, press Generate meshes. The pictures go with the run itself (resized to at most 1024 px), so the view can be closed once the run has started. For multi-view, mark each picture's side (front, left, back, right) and give the pictures of one object the same object name.",
    "inputs": [
        {
            "id": "glb",
            "label": "Meshes (GLB)",
            "type": "files",
            "many": true,
            "optional": true,
            "formats": [
                "glb"
            ]
        },
        {
            "id": "exports",
            "label": "Other formats",
            "type": "files",
            "many": true,
            "optional": true,
            "formats": [
                "obj",
                "stl",
                "ply"
            ]
        },
        {
            "id": "previews",
            "label": "Previews",
            "type": "files",
            "many": true,
            "optional": true,
            "formats": [
                "png"
            ]
        },
        {
            "id": "details",
            "label": "Mesh inventory",
            "type": "table",
            "optional": true,
            "formats": [
                "csv"
            ]
        },
        {
            "id": "status",
            "label": "Live progress",
            "type": "telemetry",
            "optional": true
        }
    ],
    "outputs": [],
    "params": [],
    "view": {
        "w": 6,
        "h": 7,
        "resize": "both"
    },
    "permissions": [
        "run"
    ],
    "esasim": {
        "version": 7
    }
}
